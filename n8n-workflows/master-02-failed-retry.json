{
  "name": "[AI-DOCTOR][MASTER-02] Failed Documents Retry (every 6h)",
  "_description": "Retries documents that failed ingestion. Exponential backoff: retry after 6h, 12h, 24h, 48h. After 5 retries, marks as resolved=true with notification to admin.",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 */6 * * *" }]
        }
      },
      "id": "trigger",
      "name": "Schedule (every 6h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/guideline_failed_documents",
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "*" },
            { "name": "resolved", "value": "eq.false" },
            { "name": "retry_count", "value": "lt.5" },
            { "name": "next_retry_at", "value": "lte.now()" },
            { "name": "order", "value": "next_retry_at.asc" },
            { "name": "limit", "value": "10" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        }
      },
      "id": "fetch-failed",
      "name": "Fetch Failed Docs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop",
      "name": "Loop Each Failed Doc",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.document_url }}",
        "options": { "timeout": 30000 }
      },
      "id": "retry-fetch",
      "name": "Retry Fetch URL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Determine if retry succeeded\nconst input = $input.first();\nconst failedDoc = $('Loop Each Failed Doc').item.json;\nconst success = !input.error;\n\nconst nextRetryHours = Math.pow(2, failedDoc.retry_count + 1) * 6;  // 6h, 12h, 24h, 48h, 96h\n\nreturn [{\n  json: {\n    id: failedDoc.id,\n    success,\n    retry_count: failedDoc.retry_count + 1,\n    resolved: success || (failedDoc.retry_count + 1 >= 5),\n    next_retry_at: success ? null : new Date(Date.now() + nextRetryHours * 3600 * 1000).toISOString(),\n    note: success ? 'auto-resolved on retry' : `retry ${failedDoc.retry_count + 1} failed`\n  }\n}];"
      },
      "id": "compute-update",
      "name": "Compute Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/guideline_failed_documents",
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $json.id }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"resolved\": {{ $json.resolved }},\n  \"resolved_at\": {{ $json.success ? '\"' + new Date().toISOString() + '\"' : 'null' }},\n  \"resolved_by\": \"{{ $json.success ? 'auto-retry' : 'null' }}\",\n  \"retry_count\": {{ $json.retry_count }},\n  \"next_retry_at\": {{ $json.next_retry_at ? '\"' + $json.next_retry_at + '\"' : 'null' }},\n  \"last_failed_at\": \"{{ new Date().toISOString() }}\"\n}"
      },
      "id": "update-doc",
      "name": "Update Failed Doc",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Schedule (every 6h)": {
      "main": [[{ "node": "Fetch Failed Docs", "type": "main", "index": 0 }]]
    },
    "Fetch Failed Docs": {
      "main": [[{ "node": "Loop Each Failed Doc", "type": "main", "index": 0 }]]
    },
    "Loop Each Failed Doc": {
      "main": [[{ "node": "Retry Fetch URL", "type": "main", "index": 0 }]]
    },
    "Retry Fetch URL": {
      "main": [[{ "node": "Compute Update", "type": "main", "index": 0 }]]
    },
    "Compute Update": {
      "main": [[{ "node": "Update Failed Doc", "type": "main", "index": 0 }]]
    },
    "Update Failed Doc": {
      "main": [[{ "node": "Loop Each Failed Doc", "type": "main", "index": 0 }]]
    }
  },
  "tags": [{ "name": "AI-DOCTOR" }, { "name": "master" }, { "name": "retry" }]
}
