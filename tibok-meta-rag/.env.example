# NCBI E-utilities API key (optional). Without it PubMed calls are capped at
# 3 req/s; with it, 10 req/s. Get one at https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Email address sent with every PubMed / Unpaywall request, as required by
# their terms of use. Unpaywall enrichment is skipped entirely if unset.
UNPAYWALL_EMAIL=
NCBI_EMAIL=
