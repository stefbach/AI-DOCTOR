# ============================================================================
# AI-DOCTOR — Environment Variables
# Copy this file to .env.local and fill in real values
# ============================================================================

# ─── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-5.4

# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key — REQUIRED for RAG migration, bulk seed, runtime, and webhooks
# Bypasses RLS. Find in Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Site / Deployment ──────────────────────────────────────────────────────
# Used by webhook redirects and admin UI
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ============================================================================
# RAG SYSTEM (added 2026-04-27)
# ============================================================================

# Feature flags — set to 'true' to activate, 'false' to disable
RAG_ENABLED=true
FEATURE_SAFETY_ALERTS=true
FEATURE_RAG_TRACE=true

# RAG runtime tuning
RAG_MIN_SIMILARITY=0.65
RAG_TOP_K=5
RAG_REASONING_EFFORT=medium

# ─── n8n Integration ────────────────────────────────────────────────────────
# Shared secret between n8n and Vercel webhooks.
# Generate with: openssl rand -hex 32
# Must match the credential 'AI-DOCTOR Webhook' in n8n.
N8N_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# ─── Admin Access ───────────────────────────────────────────────────────────
# Comma-separated list of emails authorized to approve/reject guidelines
ADMIN_EMAILS_ALLOWLIST=admin@your-domain.com,medical-lead@your-domain.com

# ─── Notifications (Resend) ─────────────────────────────────────────────────
# For master agents to send digest emails
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=medical-admin@your-domain.com
RESEND_FROM=noreply@your-domain.com

# ─── Bulk Seed (one-time setup) ─────────────────────────────────────────────
# Optional overrides for the bulk-seed scripts
SEED_MAX_ITEMS=30
SEED_DRY_RUN=false
